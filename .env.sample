# Print every command the bin/scripts run
DEBUG=1
# Show composer output
VERBOSE=0
# Print the commands without running them
DRY_RUN=0

# Magento 2 edition and version installed into build/magento by `just m2-up`
MAGENTO2_EDITION=community
MAGENTO2_VERSION=latest

#: Get those keys at https://commercemarketplace.adobe.com/
#: My Profile -> Access Keys (public key is the username, private key is the password).
#: Leave empty to use the values from ~/.environment/.env.
REPO_MAGENTO_COM_USERNAME=
REPO_MAGENTO_COM_PASSWORD=
