{
    "name": "sergiynezbritskiy/magento2-translations-checker",
    "description": "CLI tool to verify that every translatable phrase of a Magento 2 module is present and translated in its i18n dictionaries.",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "dev",
    "require": {
        "php": ">=8.2",
        "symfony/console": "^6.4 || ^7.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/php-compatibility": "^9.3",
        "phpmd/phpmd": "^3@dev",
        "phpstan/phpstan": "2.2.x-dev",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "suggest": {
        "magento/magento2-base": "Provides Magento\\Setup\\Module\\I18n, the phrase collector this tool calls at runtime",
        "magento/framework": "Required by the phrase collector at runtime",
        "magento/module-email": "Required by the phrase collector's HTML adapter at runtime"
    },
    "autoload": {
        "psr-4": {
            "SergiyNezbritskiy\\TranslationsChecker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SergiyNezbritskiy\\TranslationsChecker\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/i18n"
    ],
    "archive": {
        "exclude": ["/vendor", "/var", "/tmp", "/build"]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "phpcs": "XDEBUG_MODE=off vendor/bin/phpcs --standard=phpcs.xml",
        "fix": "XDEBUG_MODE=off vendor/bin/phpcbf --standard=phpcs.xml",
        "phpmd": "XDEBUG_MODE=off vendor/bin/phpmd analyze --format=text --ruleset=phpmd.xml src tests",
        "phpstan": "XDEBUG_MODE=off vendor/bin/phpstan analyse --level=6 src tests",
        "tests": "XDEBUG_MODE=coverage vendor/bin/phpunit --stop-on-failure --stop-on-error --coverage-html=var/reports/coverage --coverage-clover=var/reports/coverage.xml",
        "tests-debug": "vendor/bin/phpunit --coverage-html=var/reports/coverage --coverage-clover=var/reports/coverage.xml",
        "all": [
            "@phpcs",
            "@phpmd",
            "@phpstan",
            "@tests"
        ]
    }
}
